// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

// ⬇️ AGREGA ESTE MODELO AQUÍ ABAJO ⬇️
model Post {
  id        String   @id @default(uuid()) // Genera un ID único automático
  title     String   // Título del artículo sobre arquitectura/calidad
  slug      String   @unique              // URL amigable (ej: "buenas-practicas-arquitectura")
  content   String   // El contenido o cuerpo del texto
  imageUrl  String?  // El enlace de la imagen (de Cloudinary o Vercel Blob)
  createdAt DateTime @default(now())     // Fecha de publicación automática
}