// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Asegúrate de tener esta línea para que conecte a Neon
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

model Post {
  id        String   @id @default(uuid()) 
  title     String   
  slug      String   @unique              
  content   String   
  category  String   @default("ARQUITECTURA") // 🛠️ ¡AGREGA ESTA LÍNEA AQUÍ!
  imageUrl  String?  
  createdAt DateTime @default(now())     
}